import java.util.*;
public class Main
{
    public static void main(String[] args) {
        Scanner in= new Scanner(System.in);
        int n=in.nextInt();
        int[] arr=new int[n];
        
        for(int i=0;i<n;i++){
            arr[i]=in.nextInt();
            }
            int sum30=0;
            int sum60=0;
            int sum120=0;
            
            for(int i=0;i<n;i++){
                if(arr[i]==30){
                    sum30++;
                }
                else if(arr[i]==60 && sum30>=1){
                    sum30=sum30-1;
                    sum60++;
                }
                else if(arr[i]==120){
                    if(sum30>=3){
                    sum30=sum30-3;
                    sum120++;
                    }
                    else if(sum30>=1 && sum60>=1){
                    sum30=sum30-1;
                    sum60=sum60-1;
                    sum120++;
                    }
                    else{
                     System.out.println("Transaction failed");
                     return;
                }
                }
                else{
                     System.out.println("Transaction failed");
                     return;
                }
            }
            System.out.println("Transaction successful");
            
    }
}
